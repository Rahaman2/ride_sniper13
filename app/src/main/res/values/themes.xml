<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RideSniper" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0E0F13</item>
        <item name="android:navigationBarColor">#171920</item>
        <item name="android:windowBackground">#0E0F13</item>
    </style>

    <!-- Shown by the system while the app starts, then swaps to Theme.RideSniper. -->
    <style name="Theme.RideSniper.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0E0F13</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.RideSniper</item>
    </style>
</resources>
